<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <sectionGroup name="CustomerSetting">
      <section name="Keno" type="Fanex.CustomerSetting.Module.KenoStatus.Configurations.KenoSection, Fanex.CustomerSetting.Module.KenoStatus, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" />
    </sectionGroup>
    <section name="SecurityCodeSection" type="Alpha.SecurityCode.Configurations.SecurityCodeSection, Alpha.SecurityCode" />
    <sectionGroup name="Game">
      <section name="Keno" type="Fanex.Game.Keno.Configurations.KenoSection, Fanex.Game.Keno, Version=1.0.0.0, Culture=neutral" />
    </sectionGroup>
  </configSections>

  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.40.40.127/msmq/Private$/entlib" defaultCategory="Alpha-789y-AF"/>

  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" 
           resourcePath="~/App_Data/SPNames/PRO/" 
           enableWatching="1" 
           ignoreExceptionIsNotParameters="true" />
    </providers>
  </Fanex.Data.DbSettingProvider>

  <connectionStrings configSource="Web.ConnectionStrings.config" />
  <appSettings file="Web.AppSettings.config" />

  <CustomerSetting>
    <Keno enable="true" showsetting="true" exclude="1502" excludesetting="1515" />
  </CustomerSetting>

  <SecurityCodeSection active="false" siteMain="site-main" currentSite="site-results" 
                       securityCodeVerifyUrl="Security/SecurityCode/VerifySecurityCode" 
                       forceChangeSecurityCodeUrl="Security/SecurityCode/ForceChangeSecurityCode" 
                       forceChangeSecurityCodeWithoutValidationUrl="Security/SecurityCode/ForceChangeSecurityCodeWithoutValidation">
    <ignoreUrl>
    </ignoreUrl>
  </SecurityCodeSection>

  <Game>
    <!--siteid  vendor  vendorkey
        2100100  Account  WZWtzDfCJW
        2200100 E_Account  irafds59cj
        3100100  Agent  JhKI26kocP
        3200100  Agent  JhKI26kocP
        3300100  Agent  JhKI26kocP 
        4100300  Bong88  JDkPcipoeC  (789y)
        4100301  Bong88  JDkPcipoeC  (798y)         
        5200200  Internal  nxvqm5hy5s -->
    <Keno kenoResultUrl="http://keno.garcade.net/keno"
			  authenticateUrl="http://10.40.40.76:8866/authorizeCode?vendor={0}&amp;vendorKey={1}&amp;customerID={2}"
			  extendTokenUrl="http://10.40.40.76:8866/extendtoken?vendor={0}&amp;vendorKey={1}&amp;customerID={2}"
			  vendor="Agent"
			  vendorKey="JhKI26kocP"
			  siteId="3100100"
			  gameName="keno"/>
  </Game>

  <system.web>
    <compilation debug="false" targetFramework="4.6.1" />

    <httpModules>
      <add name="SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" />
    </httpModules>

    <authentication mode="Forms">
      <forms loginUrl="/site-main/_Authorization/SignIn.aspx" 
             defaultUrl="Index.aspx" path="/" name=".AGENTFORMSAUTH" 
             protection="All" cookieless="UseDeviceProfile" />
    </authentication>

    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <sessionState mode="StateServer" timeout="10" cookieless="true" stateConnectionString="tcpip=10.40.40.20:42424" />

    <machineKey validationKey="DBD341D2E939399A19F6A977A91447BB784B473FD8EAFC272440BA1BE85289C39F681921F05F8DC08E452A7292F986B311ADADD23C7D3DE0B6A0999E0B4D792C" 
                decryptionKey="A6925D7BFBEAD2B3FF1D5C54F862447209527FD7DD70B043AEB4CEBCB0BBF7E4" 
                validation="SHA1" 
                decryption="AES" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <remove name="SecurityCodeHttpModule" />
      <add name="SecurityCodeHttpModule" type="Alpha.SecurityCode.HttpModules.SecurityCodeHttpModule, Alpha.SecurityCode" 
           preCondition="managedHandler" />
    </modules>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.6.0" newVersion="2.0.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Optimization" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.1.0.0" newVersion="1.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.5.2.14234" newVersion="1.5.2.14234" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:6 /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:14 /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>

</configuration>