<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="SecurityCodeSection" type="Fanex.Razorbill.Security.Configurations.SecurityCodeSection, Fanex.Razorbill.Security" />
  </configSections>
  <appSettings>
    <add key="IsNeutralSite" value="0"/>
    <add key="ApplicationName" value="AlphaSite_NAP_EXTERNAL"/>
  </appSettings>

  <SecurityCodeSection configSource="SecurityCode.config" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <system.web>
    <machineKey
      validationKey="AB6CC64B60A95F0D577825FC3B93FA29EEACC5CDA269810AEFB484853C674B94F360C6F3C9D925D9F6C2529E5C4BF1F16F8CC7A9D5DF8FBF023F916D06F25454"
      decryptionKey="2613DFAEF2D599D999DE69E181F437C8084ABEDE7B980941AF1498527BD7BC9B"
      validation="SHA1" decryption="AES"
    />
    
    <compilation targetFramework="4.0" debug="true"/>

    <authentication mode="Forms">
      <forms loginUrl="/site-main/_Authorization/SignIn.aspx"
             defaultUrl="Index.aspx" path="/" name=".AGENTFORMSAUTH"
             protection="All" />
    </authentication>

    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>

    <customErrors mode="On" defaultRedirect="/site-main/Error.aspx">
      <error statusCode="403" redirect="/site-main/Error.aspx" />
      <error statusCode="404" redirect="/site-main/Error.aspx" />
    </customErrors>

    <sessionState mode="StateServer" timeout="10" cookieless="false" stateConnectionString="tcpip=10.40.40.20:42424" />

  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules/>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30AD4FE6B2A6AEED" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.5.0.0" newVersion="4.5.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
