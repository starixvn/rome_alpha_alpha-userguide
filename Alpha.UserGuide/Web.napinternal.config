<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="SecurityCodeSection" type="Fanex.Razorbill.Security.Configurations.SecurityCodeSection, Fanex.Razorbill.Security" />
  </configSections>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
  </appSettings>

  <SecurityCodeSection configSource="SecurityCode.config" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <system.web>
    <compilation targetFramework="4.0" debug="true"/>
    <sessionState mode="Custom" customProvider="MySessionStateStore" cookieless="true">
      <providers>
        <add name="MySessionStateStore" type="Microsoft.Web.Redis.RedisSessionStateProvider" connectionString="10.2.27.140:16379,Password=foo1@bared,abortConnect=false,configChannel=__Booksleeve_MasterChanged" applicationName="SHAREDFORMSAUTH.Prod.Internal.MBC-INDO" />
      </providers>
    </sessionState>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules/>
  </system.webServer>
</configuration>